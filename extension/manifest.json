{
  "manifest_version": 3,
  "name": "Apply with Agent (V1)",
  "version": "0.1.0",
  "description": "Local-first Apply with Agent — analyzes current page, fills with trusted data only.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_title": "🤖 Apply with Agent" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
