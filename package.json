    "test:browser": "playwright test",
    "apply:local": "tsx workers/local-apply.ts",
    "db:types": "echo \"run: supabase gen types typescript --project-id <id> > supabase/types.ts\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
