{
  "name": "autonomous-job-application-agent",
  "version": "0.1.0",
  "private": true,
  "description": "V1 free-first single-user Apply with Agent — Next.js + Supabase + local Playwright",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
